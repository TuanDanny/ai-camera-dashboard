station_id: ST-001

server:
  host: localhost
  mqtt_port: 1883
  mediamtx_rtsp_port: 8554

mqtt:
  username: edge_device
  password: changeme
  qos: 1
  keepalive: 60

camera:
  # Cac loai duoc ho tro: csi | webcam | ip_webcam (ip_webcam dung field url ben duoi)
  type: webcam
  device: /dev/video0
  # Chi dung khi camera la ip_webcam - lay tu man hinh Start server cua app IP Webcam
  url: http://192.168.1.100:8080/video
  width: 1280
  height: 720
  fps: 25
  bitrate: 2500000
  # Chi ap dung cho type: webcam (USB) - dieu chinh do sang qua v4l2-ctl
  # neu hinh anh bi toi (xem `v4l2-ctl -d /dev/videoX --list-ctrls` de biet
  # khoang gia tri cua camera dang dung). Bo comment va chinh so neu can,
  # de nguyen (comment) neu camera da du sang - gia tri mac dinh cua da
  # phan lon webcam la brightness=0, gamma=300, backlight_compensation=0.
  # brightness: 30              # thuong -64..64
  # gamma: 400                  # thuong 100..500
  # backlight_compensation: 1   # thuong 0..2

stream:
  protocol: rtsp
  path: ST-001
  url: rtsp://localhost:8554/ST-001
  reconnect_delay_s: 5

heartbeat:
  interval_s: 10

# Nguong de gui canh bao Telegram/DB - chi bao khi CHUYEN muc (binh thuong ->
# warning/critical, hoac nguoc lai khi phuc hoi), khong spam moi heartbeat.
alerts:
  cpu_temp_warn_c: 65
  cpu_temp_crit_c: 80
  disk_usage_warn_pct: 90
  disk_usage_crit_pct: 97

network:
  interface: wlan0
