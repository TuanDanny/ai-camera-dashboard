# === PostgreSQL ===
POSTGRES_DB=shtp_traffic
POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme

# === Grafana ===
GF_SECURITY_ADMIN_USER=changeme
GF_SECURITY_ADMIN_PASSWORD=changeme

# === MQTT — User 1: Thiết bị Edge (publish telemetry) ===
MQTT_EDGE_USER=edge_device
MQTT_EDGE_PASSWORD=changeme

# === MQTT — User 2: Node-RED internal (subscribe all, publish commands) ===
MQTT_NODERED_USER=nodered_service
MQTT_NODERED_PASSWORD=changeme

# === MQTT — User 3: AI Worker (publish telemetry only) ===
MQTT_AIWORKER_USER=ai_worker
MQTT_AIWORKER_PASSWORD=changeme

# === Telegram Alert + tg_bot (dieu khien tuong tac qua chat) ===
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
# Dia chi Grafana ma nguoi van hanh se bam vao tu tin nhan Telegram - dung IP
# LAN that cua may chay server nay, khong dung "localhost" (vo nghia tren dien thoai).
GRAFANA_URL=http://192.168.1.100:3000
# Danh sach Telegram user_id (SO, khong phai username) duoc phep goi cac
# lenh nguy hiem (restartyolo/restartmqtt/reboot/cleardb) trong tg_bot/ -
# cach nhau boi dau phay, vd "111111111,222222222". Lay user_id bang cach
# nhan tin cho bot @userinfobot tren Telegram. KHONG de trong o production.
TELEGRAM_ALLOWED_USER_IDS=

# === General ===
TZ=Asia/Ho_Chi_Minh
