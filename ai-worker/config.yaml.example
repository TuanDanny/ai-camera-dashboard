server:
  mqtt_host: localhost
  mqtt_port: 1883
  mqtt_username: ai_worker
  mqtt_password: changeme

model:
  path: yolov8n_ncnn_model
  device: cpu
  imgsz: 512
  conf: 0.10
  iou: 0.50
  max_det: 60
  classes: [1, 2, 3, 5, 7]
  tracker_config: tracker/traffic_bytetrack.yaml
  # backend: "cpu" (mac dinh, dung model/imgsz/iou/path o tren qua
  # ultralytics) hoac "hailo" (dung NPU Hailo-8L 13 TOPS qua HailoRT -
  # nhanh gap ~4-8 lan CPU, do thuc te ~40-46fps/camera, ~21-24ms/frame).
  # Can may co san Hailo-8L + apt package "hailo-all" da cai (cung cap
  # hailort, python3-hailort, va model mau
  # /usr/share/hailo-models/yolov8s_h8l.hef). Vi hailo_platform/picamera2
  # chi cai duoc qua apt (khong co tren PyPI), ai-worker/.venv (va
  # .venv-view neu muon xem qua NPU) can 1 lan setup them de thay duoc
  # chung:
  #   echo "/usr/lib/python3/dist-packages" | sudo tee \
  #     ai-worker/.venv/lib/python3*/site-packages/hailo_system.pth
  # Khi backend=hailo: path/imgsz/iou/device o tren bi bo qua, model duoc
  # nap tu hailo_hef_path thay vi MODEL_PATH; tracking dung ByteTrack rieng
  # cho tung lop xe (khong qua pipeline tracking cua ultralytics), van doc
  # chung tham so tu tracker_config o tren (track_high_thresh/track_buffer/
  # match_thresh).
  backend: cpu
  hailo_hef_path: /usr/share/hailo-models/yolov8s_h8l.hef

classifier:
  lock_after: 5
  class_min_conf:
    1: 0.12   # bicycle
    2: 0.18   # car
    3: 0.08   # motorcycle
    5: 0.18   # bus
    7: 0.18   # truck

direction:
  # Duong ao nam ngang o y_ratio * chieu cao khung hinh.
  # inbound_when: "increasing" neu xe di chuyen xuong duoi khung hinh (y tang) la vao,
  # "decreasing" neu nguoc lai. Tung tram co the override rieng bang khoa
  # "direction_line" (cung 2 field nay) trong muc streams ben duoi.
  default_y_ratio: 0.5
  default_inbound_when: increasing

streams:
  - station_id: ST-001
    url: rtsp://localhost:8554/ST-001
    location_name: Cong D2

publish:
  interval_s: 10
  topic_template: traffic/station/{station_id}/telemetry
  # Nhip rieng, nhanh hon, chi cho fps/inference_ms - KHONG anh huong toi
  # cua so dem xe (van dung interval_s o tren).
  status_interval_s: 3
  status_topic_template: traffic/station/{station_id}/ai_status
  # Canh bao mat/phuc hoi stream that (khong lien quan toi du lieu gia lap)
  alert_topic_template: traffic/station/{station_id}/alert
